{
  "name": "nocms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:editor && astro dev",
    "build": "bun run build:editor && astro build && bun run gate",
    "build:site": "astro build",
    "build:editor": "bun scripts/build-editor.mjs",
    "gate": "bun scripts/parity-gate.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "bun test tests/ src/lib/auth apps/relay",
    "test:e2e": "bun tests/editor.e2e.mjs",
    "verify": "biome check . && bun run typecheck && bun run test && bun run build",
    "typecheck": "astro check",
    "test:github": "bun tests/github-storage.mjs",
    "test:signin": "bun tests/sign-in.e2e.mjs",
    "relay": "bun --env-file=apps/relay/.dev.vars run apps/relay/src/server.ts"
  },
  "dependencies": {
    "astro": "7.2.8",
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler": "^4.0.0",
    "@astrojs/compiler-rs": "*",
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "morphdom": "^2.7.7",
    "playwright": "^1.62.1",
    "typescript": "^6",
    "vite": "^8.2.2"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  }
}
