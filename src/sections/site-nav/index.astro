---
const { brand } = Astro.props;
---
<nav class="nav">
  <span class="brand" data-edit="brand">{brand}</span>
  <div class="actions"><slot /></div>
</nav>
<style>
  .nav {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-2); padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .brand { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; }
  .actions { display: flex; gap: var(--space-1); align-items: center; }
</style>
