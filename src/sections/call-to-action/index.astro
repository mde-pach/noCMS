---
const { title, label, href } = Astro.props;
---
<section class="cta">
  <h2 data-edit="title">{title}</h2>
  <a class="button" href={href}>{label}</a>
</section>
<style>
  .cta {
    margin: var(--space-4) var(--space-3);
    padding: var(--space-4);
    display: flex; flex-wrap: wrap; gap: var(--space-2);
    align-items: center; justify-content: space-between;
    background: var(--surface-sunk);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .cta h2 { margin: 0; font-family: var(--font-display); font-size: var(--step-2); }
  .button {
    padding: var(--space-1) var(--space-3);
    background: var(--brand); color: var(--brand-ink);
    border-radius: var(--radius); text-decoration: none; font-weight: 600;
  }
</style>
