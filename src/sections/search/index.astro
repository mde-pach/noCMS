---
// Search runs entirely in the visitor's browser against an index built from the
// published HTML. §8.1: no server, no API key, no per-query cost, nothing to operate.
const { label = "Search" } = Astro.props;
---
<section class="search">
  <label class="visually-hidden" for="nocms-search">{label}</label>
  <div id="nocms-search" data-nocms-search></div>
</section>
<style>
  .search { padding: var(--space-3); }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }
  .search :global(.pagefind-ui__search-input) {
    width: 100%; font: inherit; padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); color: var(--ink);
  }
</style>
<script is:inline>
  // The index only exists after a build, so before the first publish — and inside the
  // editor canvas — the field shows itself as not yet available rather than erroring.
  (async () => {
    const host = document.querySelector("[data-nocms-search]");
    if (!host) return;
    try {
      const mod = await import(/* @vite-ignore */ "/pagefind/pagefind-ui.js");
      new mod.PagefindUI({ element: "[data-nocms-search]", showSubResults: true });
    } catch {
      host.innerHTML =
        '<input class="pagefind-ui__search-input" placeholder="Search — available once published" disabled />';
    }
  })();
</script>
