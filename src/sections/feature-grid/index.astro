---
const { title, items = [] } = Astro.props;
---
<section class="grid-section">
  {title && <h2 class="heading" data-edit="title">{title}</h2>}
  <ul class="grid">
    {items.map((item: { title: string; body: string }) => (
      <li class="card">
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </li>
    ))}
  </ul>
</section>
<style>
  .grid-section { padding: var(--space-4) var(--space-3); }
  .heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display); font-size: var(--step-2);
  }
  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--space-2);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .card {
    padding: var(--space-3);
    background: var(--surface-sunk);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .card h3 { margin: 0 0 var(--space-1); font-size: var(--step-1); }
  .card p  { margin: 0; color: var(--ink-muted); font-size: var(--step--1); }
</style>
