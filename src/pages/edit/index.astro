---
// The editor ships inside the site it edits. It holds no secrets: in GitHub mode the
// owner's token lives in their browser, in local mode there is no token at all.
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Edit · noCMS</title>
    <link rel="stylesheet" href="/_nocms/editor.css" />
  </head>
  <body data-pagefind-ignore="all">
    <noscript>The editor needs JavaScript. Your site does not.</noscript>
    <script is:inline type="module" src="/_nocms/editor.js"></script>
  </body>
</html>
